# Generated-resolution template: Q16.16 Mandelbrot, 8 lanes / 4 warps.
# Launch all four warps at PC 0, all lanes active.
# ARG0=x_start, ARG1=y_start, ARG2=x_step, ARG3=y_step (Q16.16).
# First width*height words: RGB; next width*height words: iterations.
RDSR r1, LANE_ID
RDSR r2, WARP_ID
LDI r12, 128
LI r13, 262144, r15

pixels:
    PUSHM
    LDI r14, @HEIGHT@
    SLT r10, r2, r14
    SETM r10
    BRANY coordinates
    POPM
    RET

coordinates:
    SHL r3, r1, 16
    RDSR r14, ARG2
    MUL r3, r3, r14
    RDSR r14, ARG0
    ADD r3, r3, r14
    SHL r4, r2, 16
    RDSR r14, ARG3
    MUL r4, r4, r14
    RDSR r14, ARG1
    ADD r4, r4, r14
    LDI r5, 0
    LDI r6, 0
    LDI r7, 0
    PUSHM

iterate:
    MUL r8, r5, r5
    MUL r9, r6, r6
    ADD r10, r8, r9
    SLT r10, r13, r10
    SEQ r10, r10, r0
    SETM r10
    SLT r10, r7, r12
    SETM r10
    BRANY update
    BR color

update:
    MUL r10, r5, r6
    SHL r10, r10, 1
    ADD r6, r10, r4
    SUB r5, r8, r9
    ADD r5, r5, r3
    LDI r14, 1
    ADD r7, r7, r14
    BR iterate

color:
    # Restore escaped lanes so every valid pixel is stored.
    POPM
    LDI r14, 127
    AND r10, r7, r14
    LDI r15, 255
    SHL r8, r10, 3
    AND r8, r8, r15
    SHL r8, r8, 16
    SHL r9, r10, 2
    ADD r9, r9, r10
    AND r9, r9, r15
    SHL r9, r9, 8
    OR r8, r8, r9
    SHL r11, r10, 3
    SHL r14, r10, 2
    ADD r11, r11, r14
    ADD r11, r11, r10
    AND r11, r11, r15
    OR r8, r8, r11
    # Address = (row * width + column) * 4. Q16 MUL performs exact
    # integer multiplication here because only row is scaled by 65536.
    SHL r14, r2, 16
    LDI r15, @WIDTH@
    MUL r14, r14, r15
    ADD r14, r14, r1
    SHL r14, r14, 2
    STR r8, 0(r14)
    LI r15, @ITERATION_BASE@, r9
    ADD r14, r14, r15
    STR r7, 0(r14)
    LDI r14, 8
    ADD r1, r1, r14
    LDI r14, @WIDTH@
    SLT r10, r1, r14
    SETM r10
    BRANY next_columns
    POPM
    RDSR r1, LANE_ID
    RDSR r14, WARP_COUNT
    ADD r2, r2, r14
    BR pixels
next_columns:
    POPM
    BR pixels
